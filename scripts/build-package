#!/usr/bin/env bash
#
# Build a Debian source package locally with `osc build` inside a privileged
# Ubuntu Docker container.
#
# Usage: build-package [--dry-run] [--fast|--reuse] <srcdir> [repo] [arch]
#   <srcdir>   dir containing the .dsc to build (e.g. build/p4c)
#   [repo]     OBS repo target, default xUbuntu_22.04
#   [arch]     build arch, default x86_64
#
# NB 1: On NixOS and possibly other hosts, vm-type=chroot is broken, so builds
# are usually very slow. (util-linux/getopt installs too late for some postinst
# scripts). You can try it out, though, by setting LOCALBUILD_VM_TYPE=chroot.
#
# NB 2: For vm-type=qemu, the host system needs to register any foreign arch
# with binfmt's F flag, and needs to use a static qemu. On NixOS these can be
# done with boot.binfmt.preferStaticEmulators = true.
#
# Build tiers:
#   default    OBS-faithful clean build.
#
#              Uses vm-type=(kvm|qemu) depending on target arch.
#
#   --fast     Inner dev loop. Enables ccache and resolves build-deps from
#              locally-built .debs in build/debs (so the pi -> bmv2 -> p4c chain
#              needs no OBS round-trip). --keep-pkgs saves the built .debs back
#              into build/debs to feed the next package.
#   --reuse    --fast plus --noinit --offline: skips build-root re-init and network
#              entirely. Requires one standalone --fast before it works.
#
# LOCALBUILD_VM_TYPE overrides the chosen vm-type.
#
# Credentials: $OBS_USERNAME + $OBS_PASSWORD are written to a tmpfs osc.config
# (chmod 600, trap-deleted) and bind-mounted read-only. If only the username is
# set (or neither), a TransientCredentialsManager config is written instead and
# osc prompts for the password at run time (needs a TTY). OSCRC overrides the
# config path (for tests) and disables trap-cleanup.
#
# --dry-run prints the docker invocation instead of running it.

set -euo pipefail
die() { echo "error: $*" >&2; exit 1; }

dry_run=0
fast=0
reuse=0
while [[ "${1:-}" == --* ]]; do
    case "$1" in
        --dry-run) dry_run=1; shift ;;
        --fast)    fast=1; shift ;;
        --reuse)   reuse=1; fast=1; shift ;;  # --reuse implies --fast
        *) die "unknown option: $1" ;;
    esac
done

srcdir="${1:?Usage: build-package [--dry-run] [--fast|--reuse] <srcdir> [repo] [arch]}"
repo="${2:-xUbuntu_22.04}"
arch="${3:-x86_64}"

[[ -d "$srcdir" ]] || die "no such dir: $srcdir"
srcdir_abs="$(cd "$srcdir" && pwd)"
shopt -s nullglob; dscs=( "$srcdir"/*.dsc ); shopt -u nullglob
(( ${#dscs[@]} > 0 )) || die "no .dsc in $srcdir"
dsc="$(basename "${dscs[0]}")"

# Synthesize the osc.config on tmpfs.
_cleanup=()
cleanup() { (( ${#_cleanup[@]} )) && rm -f "${_cleanup[@]}"; }
trap cleanup EXIT
oscrc="${OSCRC:-$(mktemp)}"
[[ -n "${OSCRC:-}" ]] || _cleanup+=("$oscrc")
: > "$oscrc"; chmod 600 "$oscrc"
apiurl="https://api.opensuse.org"
if [[ -n "${OBS_USERNAME:-}" && -n "${OBS_PASSWORD:-}" ]]; then
    cat > "$oscrc" <<EOF
[general]
apiurl = $apiurl

[$apiurl]
user = $OBS_USERNAME
pass = $OBS_PASSWORD
EOF
else
    user="${OBS_USERNAME:-}"
    [[ -n "$user" ]] || read -rp "OBS username: " user
    cat > "$oscrc" <<EOF
[general]
apiurl = $apiurl

[$apiurl]
user = $user
credentials_mgr_class = osc.credentials.TransientCredentialsManager
EOF
fi

run() { if (( dry_run )); then printf '+'; printf ' %q' "$@"; printf '\n'; else "$@"; fi; }

# Reuse the host's OBS session so the dev loop never prompts for a password when
# it's available.
cookie_mounts=()
host_cookiejar="${XDG_STATE_HOME:-$HOME/.local/state}/osc/cookiejar"
if [[ -f "$host_cookiejar" ]]; then
    cookie_tmp="$(mktemp)"; cp "$host_cookiejar" "$cookie_tmp"; _cleanup+=("$cookie_tmp")
    cookie_mounts+=(--mount "type=bind,source=$cookie_tmp,target=/root/.local/state/osc/cookiejar")
fi

# Bootstrap the build image once (osc + KVM + qemu, per install-osc-build-deps.sh).
if ! docker image inspect obs-build-image &>/dev/null; then
    echo "obs-build-image not found, bootstrapping..." >&2
    docker rm -f obs-build-bootstrap &>/dev/null || true
    run docker run --privileged --name obs-build-bootstrap \
        --mount "type=bind,source=$PWD,target=/repo" --workdir /repo \
        ubuntu:latest ./scripts/install-osc-build-deps.sh
    run docker commit obs-build-bootstrap obs-build-image
    run docker rm obs-build-bootstrap
fi

# vm-type: a native arch uses KVM for a clean build; a foreign arch chroots under
# qemu (host binfmt). LOCALBUILD_VM_TYPE overrides (e.g. =chroot for a no-VM loop).
if [[ "$arch" == "$(uname -m)" ]]; then vm_type="${LOCALBUILD_VM_TYPE:-kvm}"
else vm_type="${LOCALBUILD_VM_TYPE:-chroot}"; fi
vm_args=(--vm-type "$vm_type")
case "$vm_type" in kvm|qemu) vm_args+=(--vm-memory 20000 --vm-disk-size 16384) ;; esac

# Keep KVM (disk image) and chroot (directory tree) build roots in separate dirs
# so switching tiers doesn't clobber either, and each stays warm for --reuse.
mkdir -p build/.osc-cache
if [[ "$vm_type" == chroot ]]; then buildroot_host="$PWD/build/.osc-buildroot-chroot"
else buildroot_host="$PWD/build/.osc-buildroot"; fi
mkdir -p "$buildroot_host"

# Fast-mode osc args + the local .deb dir mount. --reuse adds a fully-offline
# reuse of the warmed root.
fast_args=()
fast_mounts=()
if (( fast )); then
    mkdir -p build/debs
    fast_args+=(--ccache --prefer-pkgs /debs --keep-pkgs /debs)
    fast_mounts+=(--mount "type=bind,source=$PWD/build/debs,target=/debs")
    (( reuse )) && fast_args+=(--noinit --offline)
fi

# Allocate a TTY only when we have one. osc's Transient password prompt needs it,
# but a non-interactive run (env creds, CI) must not pass -t or docker errors.
tty_args=()
[[ -t 0 ]] && tty_args=(-it)

run docker run --rm "${tty_args[@]}" --privileged \
    --mount "type=bind,source=$srcdir_abs,target=/pkg" \
    --mount "type=bind,source=$oscrc,target=/tmp/osc.config,readonly" \
    --mount "type=bind,source=$PWD/build/.osc-cache,target=/var/tmp/osbuild-packagecache" \
    --mount "type=bind,source=$buildroot_host,target=/var/tmp/build-root-root" \
    "${cookie_mounts[@]}" \
    "${fast_mounts[@]}" \
    --workdir /pkg \
    obs-build-image \
    osc --config /tmp/osc.config build --trust-all-projects "${vm_args[@]}" "${fast_args[@]}" \
        --alternative-project home:p4lang --local-package \
        "$repo" "$arch" "$dsc"
