Description: Append the optional bdwgc components only when the distro ships them
 Seems like the last change here made some bad assumptions when using
 system-provided libraries.
Author: Bryan Richter <b@chreekat.net>
Forwarded: no
--- a/cmake/BDWGC.cmake
+++ b/cmake/BDWGC.cmake
@@ -14,11 +14,14 @@
   if(P4C_USE_PREINSTALLED_BDWGC)
     option(ENABLE_MULTITHREAD "Use multithreading" OFF)
     find_package(LibGc 7.2.0 REQUIRED)
-    # Some distros ship libgc/libcord without libgctba; only add it if present.
+    # Append the optional bdwgc components only when the distro ships them.
     find_library(LIBGC_GCTBA_LIBRARY NAMES gctba)
-    if(NOT LIBGC_GCTBA_LIBRARY)
-      message(STATUS "libgctba not found; using libgc/libcord only")
-      set(LIBGC_LIBRARIES gc cord)
+    find_library(LIBGC_CORD_LIBRARY NAMES cord)
+    if(LIBGC_GCTBA_LIBRARY)
+      list(APPEND LIBGC_LIBRARIES gctba)
+    endif()
+    if(LIBGC_CORD_LIBRARY)
+      list(APPEND LIBGC_LIBRARIES cord)
     endif()
     check_function_exists (GC_print_stats HAVE_GC_PRINT_STATS)
   else()
