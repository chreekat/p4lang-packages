#!/usr/bin/env bash
#
# Build a Debian source package locally with `osc build` inside a privileged
# Ubuntu Docker container, as a sanity check before pushing to OBS.
#
# Usage: build-package [--dry-run] <srcdir> [repo] [arch]
#   <srcdir>   dir containing the .dsc to build (e.g. build/p4c)
#   [repo]     OBS repo target, default Raspbian_11
#   [arch]     build arch, default aarch64
#
# A foreign arch (!= host) builds in a chroot under user-mode qemu, which needs
# the host to register that arch with binfmt's F (fix-binary) flag + a static
# qemu (on NixOS: boot.binfmt.preferStaticEmulators). Native builds use KVM.
# LOCALBUILD_VM_TYPE overrides the chosen vm-type.
#
# Credentials: $OBS_USERNAME + $OBS_PASSWORD are written to a tmpfs osc.config
# (chmod 600, trap-deleted) and bind-mounted read-only. If only the username is
# set (or neither), a TransientCredentialsManager config is written instead and
# osc prompts for the password at run time. OSCRC overrides the config path (for
# tests) and disables trap-cleanup.
#
# --dry-run prints the docker invocation instead of running it.

set -euo pipefail
die() { echo "error: $*" >&2; exit 1; }

dry_run=0
[[ "${1:-}" == "--dry-run" ]] && { dry_run=1; shift; }

srcdir="${1:?Usage: build-package [--dry-run] <srcdir> [repo] [arch]}"
repo="${2:-Raspbian_11}"
arch="${3:-aarch64}"

[[ -d "$srcdir" ]] || die "no such dir: $srcdir"
srcdir_abs="$(cd "$srcdir" && pwd)"
shopt -s nullglob; dscs=( "$srcdir"/*.dsc ); shopt -u nullglob
(( ${#dscs[@]} > 0 )) || die "no .dsc in $srcdir"
dsc="$(basename "${dscs[0]}")"

# Synthesize the osc.config on tmpfs.
oscrc="${OSCRC:-$(mktemp)}"
[[ -n "${OSCRC:-}" ]] || trap 'rm -f "$oscrc"' EXIT
: > "$oscrc"; chmod 600 "$oscrc"
apiurl="https://api.opensuse.org"
if [[ -n "${OBS_USERNAME:-}" && -n "${OBS_PASSWORD:-}" ]]; then
    cat > "$oscrc" <<EOF
[general]
apiurl = $apiurl

[$apiurl]
user = $OBS_USERNAME
pass = $OBS_PASSWORD
EOF
else
    user="${OBS_USERNAME:-}"
    [[ -n "$user" ]] || read -rp "OBS username: " user
    cat > "$oscrc" <<EOF
[general]
apiurl = $apiurl

[$apiurl]
user = $user
credentials_mgr_class = osc.credentials.TransientCredentialsManager
EOF
fi

run() { if (( dry_run )); then printf '+'; printf ' %q' "$@"; printf '\n'; else "$@"; fi; }

# Bootstrap the build image once (osc + KVM + qemu, per install-osc-build-deps.sh).
if ! docker image inspect obs-build-image &>/dev/null; then
    echo "obs-build-image not found, bootstrapping..." >&2
    docker rm -f obs-build-bootstrap &>/dev/null || true
    run docker run --privileged --name obs-build-bootstrap \
        --mount "type=bind,source=$PWD,target=/repo" --workdir /repo \
        ubuntu:latest ./scripts/install-osc-build-deps.sh
    run docker commit obs-build-bootstrap obs-build-image
    run docker rm obs-build-bootstrap
fi

# Persistent caches under build/ (gitignored): downloaded .debs + the buildroot.
mkdir -p build/.osc-cache build/.osc-buildroot

# A foreign arch can't be KVM-virtualized on the host, so build it in a chroot
# via user-mode qemu (host binfmt); a native arch uses KVM. chroot is not a VM,
# so it takes no vm-memory/vm-disk-size.
if [[ "$arch" == "$(uname -m)" ]]; then vm_type="${LOCALBUILD_VM_TYPE:-kvm}"
else vm_type="${LOCALBUILD_VM_TYPE:-chroot}"; fi
vm_args=(--vm-type "$vm_type")
case "$vm_type" in kvm|qemu) vm_args+=(--vm-memory 20000 --vm-disk-size 16384) ;; esac

# Mount ONLY the source-package dir at /pkg -- not the repo. This repo is a git
# submodule whose .git is a file with a relative pointer that dangles inside the
# container; with the repo above the workdir, osc's VCS probe walks into it and
# dies ("not a git repository"). /pkg has no .git ancestor, so the probe is inert.
# --alternative-project selects home:p4lang's build config (we're not in an osc
# checkout); --local-package makes the local .dsc the source of truth.
run docker run --rm -it --privileged \
    --mount "type=bind,source=$srcdir_abs,target=/pkg" \
    --mount "type=bind,source=$oscrc,target=/tmp/osc.config,readonly" \
    --mount "type=bind,source=$PWD/build/.osc-cache,target=/var/tmp/osbuild-packagecache" \
    --mount "type=bind,source=$PWD/build/.osc-buildroot,target=/var/tmp/build-root-root" \
    --workdir /pkg \
    obs-build-image \
    osc --config /tmp/osc.config build --trust-all-projects "${vm_args[@]}" \
        --alternative-project home:p4lang --local-package \
        "$repo" "$arch" "$dsc"
