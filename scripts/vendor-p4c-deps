#!/usr/bin/env bash
#
# Vendor p4c's CMake FetchContent dependencies as quilt components.
#
# Usage: vendor-p4c-deps <srctree> <destdir>
#        vendor-p4c-deps --update
#
# <srctree> is a checked-out p4c tag. Each dep is unpacked into <srctree>/<dep>/
# for debian/rules to point FETCHCONTENT_SOURCE_DIR_* at, and written to
# <destdir>/p4lang-p4c_<upstream-version>.orig-<dep>.tar.gz, the name
# dpkg-source requires of a component tarball. The upstream version comes from
# p4lang-p4c/changelog.
#
# p4c fetches these during its CMake build, which a sandboxed .deb build cannot
# do. We fetch them ahead of time instead. Our pins are checked against p4c's
# own declarations first, so a p4c bump that moves a dep fails here rather than
# silently building against the wrong tree.
#
# --update rewrites the pins below to whatever p4c declares at the version in
# p4lang-p4c/changelog, verifying every tarball hash by download.

set -Eeuo pipefail

die() { echo "error: $*" >&2; exit 1; }

self=$(readlink -f "$0")

usage="Usage: vendor-p4c-deps <srctree> <destdir> | --update"
update=0
if [[ "${1:-}" == --update ]]; then
    update=1
else
    srctree="${1:?$usage}"
    destdir="${2:?$usage}"
    [[ -f "$srctree/CMakeLists.txt" ]] || die "$srctree is not a p4c source tree"
fi

# Both modes work at the version named by the changelog.
[[ -f p4lang-p4c/changelog ]] || die "cannot find p4lang-p4c/changelog. Run from the repo root."
name=p4lang-p4c
deb_version=$(dpkg-parsechangelog -l p4lang-p4c/changelog -S Version)
ver="${deb_version%-*}"

#
# Our pins
#
# Each is asserted against p4c's own declaration below, so these are a mirror,
# not an independent decision. --update refreshes them.
#

abseil_version=20240722.1
abseil_sha=40cee67604060a7c8794d931538cb55f4d444073e556980c88b6c49bb9b19bb7

protobuf_version=25.3
protobuf_sha=d19643d265b978383352b3143f04c0641eea75a75235c111cc01a1350173180e

p4runtime_commit=ec4eb5ef70dbcbcbf2f8357a4b2b8c2f218845a5
p4runtime_sha=30b26c0e873af995187677f930a1ea60f722f26a5a5168869bc3f35388511513

inja_commit=3741c73ba78babd2ed88f2acf2fcd6dafdb878e8
inja_sha=9f90a8a2ada90ce7b7affdf2a79ceece065b5e929e7678410b24d473ebbe55ad

# Where p4c declares each dep. FetchContent_Declare only runs when the
# enclosing CMake code runs, so these are scattered rather than central.
abseil_cmake="cmake/Abseil.cmake"
protobuf_cmake="cmake/Protobuf.cmake"
p4runtime_cmake="CMakeLists.txt"
inja_cmake="backends/p4tools/modules/testgen/CMakeLists.txt"

#
# Reading p4c's declarations
#

# The value of <field> inside p4c's FetchContent_Declare block for <dep>.
declared_field() {
    local file="$1" dep="$2" field="$3"
    awk -v dep="$dep" -v field="$field" '
        tolower($1) ~ /^fetchcontent_declare\(?$/ { inblock = 1; named = 0; next }
        inblock && $1 == ")"                      { inblock = 0; named = 0; next }
        inblock && !named                         { named = ($1 == dep); next }
        inblock && named && $1 == field           { sub(/^SHA256=/, "", $2); print $2; exit }
    ' "$file"
}

# The value of a plain set(<var> ...) in a p4c CMake file.
declared_var() {
    local file="$1" var="$2"
    sed -nE "s/^[[:space:]]*set\(${var}[[:space:]]+\"?([^\")]+)\"?\).*/\1/p" "$file" | head -1
}

#
# Pin checking
#

assert_pin() {
    local what="$1" want="$2" got="$3" where="$4"
    [[ -n "$got" ]] || die "cannot read $what from $where -- p4c's CMake layout changed"
    [[ "$got" == "$want" ]] \
        || die "$what drift: p4c declares '$got', we vendor '$want' ($where). Run 'just revendor'?"
}

check_pins() {
    local f

    f="$abseil_cmake"
    assert_pin "abseil version" "$abseil_version" "$(declared_var "$srctree/$f" P4C_ABSEIL_VERSION)" "$f"
    assert_pin "abseil sha256" "$abseil_sha" "$(declared_field "$srctree/$f" abseil URL_HASH)" "$f"

    f="$protobuf_cmake"
    assert_pin "protobuf version" "$protobuf_version" "$(declared_var "$srctree/$f" P4C_PROTOBUF_VERSION)" "$f"
    assert_pin "protobuf sha256" "$protobuf_sha" "$(declared_field "$srctree/$f" protobuf URL_HASH)" "$f"

    # p4c pins these by commit only, so there is no upstream checksum to match;
    # ours covers GitHub's archive of that commit.
    f="$p4runtime_cmake"
    assert_pin "p4runtime commit" "$p4runtime_commit" "$(declared_field "$srctree/$f" p4runtime GIT_TAG)" "$f"

    f="$inja_cmake"
    assert_pin "inja commit" "$inja_commit" "$(declared_field "$srctree/$f" inja GIT_TAG)" "$f"

    echo "All four dependency pins match p4c's declarations."
}

#
# Vendoring
#

# Fetch a pinned tarball to <out> and unpack it under <dir> as a quilt component.
vendor_tarball() {
    local dir="$1" out="$2" url="$3" sha="$4"
    echo "Vendoring $url"
    curl -fSL "$url" -o "$out"
    echo "$sha  $out" | sha256sum -c -
    mkdir -p "$dir"
    tar -xzf "$out" --strip-components=1 -C "$dir"
}

component() { echo "$destdir/${name}_${ver}.orig-$1.tar.gz"; }

vendor_deps() {
    # Abseil is vendored because the system version is too old for protobuf
    # 25.3, and Debian's abseil has a separate packaging problem anyway. We need
    # to drop some ancient macro usage
    # (https://salsa.debian.org/debian/abseil/-/merge_requests/5)
    vendor_tarball "$srctree/abseil" "$(component abseil)" \
        "https://github.com/abseil/abseil-cpp/releases/download/${abseil_version}/abseil-cpp-${abseil_version}.tar.gz" \
        "$abseil_sha"

    # The protobuf on Ubuntu 22.04 is just ancient. Plus it depends on the
    # system abseil, which doesn't work.
    vendor_tarball "$srctree/protobuf" "$(component protobuf)" \
        "https://github.com/protocolbuffers/protobuf/releases/download/v${protobuf_version}/protobuf-${protobuf_version}.tar.gz" \
        "$protobuf_sha"

    # We haven't packaged p4runtime yet.
    vendor_tarball "$srctree/p4runtime" "$(component p4runtime)" \
        "https://github.com/p4lang/p4runtime/archive/${p4runtime_commit}.tar.gz" \
        "$p4runtime_sha"

    # The test tools render test templates with inja, which Ubuntu doesn't ship.
    vendor_tarball "$srctree/inja" "$(component inja)" \
        "https://github.com/pantor/inja/archive/${inja_commit}.tar.gz" \
        "$inja_sha"
}

#
# Pin updating (--update)
#

declared() {
    local what="$1" val="$2"
    [[ -n "$val" ]] || die "cannot read $what -- p4c's CMake layout changed"
    echo "$val"
}

fetched_sha() {
    local url="$1"
    echo "Fetching $url" >&2
    curl -fsSL "$url" -o "$workdir/tarball" || die "cannot fetch $url"
    sha256sum "$workdir/tarball" | cut -d' ' -f1
}

set_pin() {
    local var="$1" val="$2"
    grep -q "^$var=" "$self" || die "no pin '$var=' in $self"
    sed -i "s/^$var=.*/$var=$val/" "$self"
}

update_pins() {
    local tag raw sha f
    tag="v$ver"
    raw="https://raw.githubusercontent.com/p4lang/p4c/$tag"

    echo "Reading p4c's dependency declarations at $tag..."
    workdir=$(mktemp -d)
    trap 'rm -rf "$workdir"' EXIT
    for f in "$abseil_cmake" "$protobuf_cmake" "$p4runtime_cmake" "$inja_cmake"; do
        curl -fsSL --create-dirs -o "$workdir/$f" "$raw/$f" \
            || die "cannot fetch $raw/$f -- does tag $tag exist?"
    done

    abseil_version=$(declared "abseil version" "$(declared_var "$workdir/$abseil_cmake" P4C_ABSEIL_VERSION)")
    abseil_sha=$(declared "abseil sha256" "$(declared_field "$workdir/$abseil_cmake" abseil URL_HASH)")
    protobuf_version=$(declared "protobuf version" "$(declared_var "$workdir/$protobuf_cmake" P4C_PROTOBUF_VERSION)")
    protobuf_sha=$(declared "protobuf sha256" "$(declared_field "$workdir/$protobuf_cmake" protobuf URL_HASH)")
    p4runtime_commit=$(declared "p4runtime commit" "$(declared_field "$workdir/$p4runtime_cmake" p4runtime GIT_TAG)")
    inja_commit=$(declared "inja commit" "$(declared_field "$workdir/$inja_cmake" inja GIT_TAG)")

    # Hash every tarball ourselves: for abseil/protobuf the result must match
    # p4c's declared hash; for the commit-pinned deps (no upstream hash
    # exists) our hash of GitHub's archive becomes the pin.
    sha=$(fetched_sha "https://github.com/abseil/abseil-cpp/releases/download/${abseil_version}/abseil-cpp-${abseil_version}.tar.gz")
    [[ "$sha" == "$abseil_sha" ]] || die "abseil tarball hashes $sha but p4c declares $abseil_sha"
    sha=$(fetched_sha "https://github.com/protocolbuffers/protobuf/releases/download/v${protobuf_version}/protobuf-${protobuf_version}.tar.gz")
    [[ "$sha" == "$protobuf_sha" ]] || die "protobuf tarball hashes $sha but p4c declares $protobuf_sha"
    p4runtime_sha=$(fetched_sha "https://github.com/p4lang/p4runtime/archive/${p4runtime_commit}.tar.gz")
    inja_sha=$(fetched_sha "https://github.com/pantor/inja/archive/${inja_commit}.tar.gz")

    set_pin abseil_version "$abseil_version"
    set_pin abseil_sha "$abseil_sha"
    set_pin protobuf_version "$protobuf_version"
    set_pin protobuf_sha "$protobuf_sha"
    set_pin p4runtime_commit "$p4runtime_commit"
    set_pin p4runtime_sha "$p4runtime_sha"
    set_pin inja_commit "$inja_commit"
    set_pin inja_sha "$inja_sha"

    echo "Pins in $self now match p4c $tag:"
    git --no-pager diff -- "$self"
}

if (( update )); then
    update_pins
else
    check_pins
    vendor_deps
fi
